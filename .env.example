# ID del Google Spreadsheet con los artículos
SHEET_ID=1Pj0-pkQqJQSS9Mv7y0PDvP-H9W_l_0kyKph8esTABOY

# ID del Google Spreadsheet con los centros de negocio
CENTROS_SHEET_ID=1i9Je74fLspED4WiMJHPCDGrxXsiE1x4O6Do7DFhlyW0

# ID del Google Spreadsheet con los solicitantes (solo se listan los activos)
SOLICITANTES_SHEET_ID=19Z21VDaqtKOC9IolM6KPTQ6h4GY4SVR4C893tAIrank
# (Opcional) gid de la pestaña a leer; si no se define, se usa la primera
SOLICITANTES_SHEET_GID=789724525

# Cuenta de servicio de Google (con acceso al spreadsheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=defontana-etl@defontana-centralizacion-datos.iam.gserviceaccount.com

# private_key del JSON de la cuenta de servicio.
# Pega el valor completo entre comillas; deja los \n tal cual (se convierten en runtime).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Redis (Upstash): mensajes del chat de pedidos
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Carpeta de Drive (compartida como Editor con la cuenta de servicio) donde se
# crea "chat de pedidos/<folio>/" para los adjuntos del chat
DRIVE_CHAT_ROOT_ID=1TEcDi-fZ8ImRYqDyvuXYVXhpvyFIt_Fp

# Login con Google (OAuth interno de Workspace): envio de correos como cada usuario.
# Redirect URI a registrar en Google Cloud: <dominio>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# (Opcional) correos de gerencia en copia de los reportes, separados por coma.
# Por defecto: gerencia@nebchile.cl
GERENCIA_EMAIL=
